NODE_ENV=production
PORT=3001

API_BASE_URL=https://api.yourdomain.com
FRONTEND_URL=https://pos.yourdomain.com

DATABASE_URL=postgresql://USERNAME:PASSWORD@HOST:5432/DATABASE_NAME?schema=public

JWT_SECRET=CHANGE_ME
JWT_EXPIRES_IN=1d

JWT_REFRESH_SECRET=CHANGE_ME
JWT_REFRESH_EXPIRES_IN=7d

MPESA_ENVIRONMENT=production

MPESA_CONSUMER_KEY=YOUR_PRODUCTION_CONSUMER_KEY
MPESA_CONSUMER_SECRET=YOUR_PRODUCTION_CONSUMER_SECRET

MPESA_SHORTCODE=YOUR_PAYBILL_OR_TILL_NUMBER
MPESA_PASSKEY=YOUR_PRODUCTION_PASSKEY

MPESA_OAUTH_URL=https://api.safaricom.co.ke/oauth/v1/generate?grant_type=client_credentials

MPESA_STK_PUSH_URL=https://api.safaricom.co.ke/mpesa/stkpush/v1/processrequest
MPESA_STK_QUERY_URL=https://api.safaricom.co.ke/mpesa/stkpushquery/v1/query

MPESA_CALLBACK_URL=https://api.yourdomain.com/payments/mpesa/callback

CORS_ORIGIN=https://your-future-domain.example

INVENTORY_RESERVATION_EXPIRY_MINUTES=15

LOG_LEVEL=info
