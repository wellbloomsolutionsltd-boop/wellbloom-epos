generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Tenant {
  id   String @id @default(cuid())
  name String
  code String @unique

  branches              Branch[]
  products              Product[]
  users                 User[]
  customers             Customer[]
  sales                 Sale[]
  shifts                Shift[]
  cashMovements         CashDrawerMovement[]
  cashMovementRequests  CashMovementRequest[]
  endOfDays             EndOfDay[]
  returns               Return[]
  orders                Order[]
  inventoryMovements    InventoryMovement[]
  inventoryReservations InventoryReservation[]
  paymentTransactions   PaymentTransaction[]
  posCheckouts          PosCheckout[]
  productPrices         ProductPrice[]
  auditLogs             AuditLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Branch {
  id   String @id @default(cuid())
  name String
  code String

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  inventory             Inventory[]
  users                 User[]
  sales                 Sale[]
  shifts                Shift[]
  cashMovements         CashDrawerMovement[]
  cashMovementRequests  CashMovementRequest[]
  endOfDays             EndOfDay[]
  returns               Return[]
  orders                Order[]
  inventoryMovements    InventoryMovement[]
  inventoryReservations InventoryReservation[]
  paymentTransactions   PaymentTransaction[]
  posCheckouts          PosCheckout[]
  productPrices         ProductPrice[]

  isActive         Boolean @default(true)
  fulfilsEcommerce Boolean @default(true)
  allowsPickup     Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, code])
}

model Product {
  id      String  @id @default(cuid())
  name    String
  sku     String
  barcode String?

  sellingPrice Decimal  @db.Decimal(12, 2)
  costPrice    Decimal? @db.Decimal(12, 2)

  isActive Boolean @default(true)

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  inventory             Inventory[]
  saleItems             SaleItem[]
  returnItems           ReturnItem[]
  orderItems            OrderItem[]
  inventoryMovements    InventoryMovement[]
  inventoryReservations InventoryReservation[]
  posCheckoutItems      PosCheckoutItem[]
  prices                ProductPrice[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, sku])
  @@unique([tenantId, barcode])
}

model Inventory {
  id String @id @default(cuid())

  branchId String
  branch   Branch @relation(fields: [branchId], references: [id])

  productId String
  product   Product @relation(fields: [productId], references: [id])

  quantity    Decimal @default(0) @db.Decimal(12, 3)
  reservedQty Decimal @default(0) @db.Decimal(12, 3)

  reorderLevel Decimal? @db.Decimal(12, 3)
  minimumStock Decimal? @db.Decimal(12, 3)
  maximumStock Decimal? @db.Decimal(12, 3)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([branchId, productId])
}

model ProductPrice {
  id String @id @default(cuid())

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  productId String
  product   Product @relation(fields: [productId], references: [id])

  branchId String?
  branch   Branch? @relation(fields: [branchId], references: [id])

  channel  PriceChannel
  price    Decimal      @db.Decimal(12, 2)
  isActive Boolean      @default(true)

  startsAt DateTime?
  endsAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([productId])
  @@index([branchId])
  @@index([channel])
  @@index([isActive])
  @@index([startsAt])
  @@index([endsAt])
}

model User {
  id           String @id @default(cuid())
  firstName    String
  lastName     String
  email        String
  passwordHash String

  role     UserRole @default(CASHIER)
  isActive Boolean  @default(true)

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  branchId String?
  branch   Branch? @relation(fields: [branchId], references: [id])

  sales         Sale[]
  shifts        Shift[]
  cashMovements CashDrawerMovement[]

  cashMovementRequestsMade     CashMovementRequest[] @relation("CashMovementRequestedBy")
  cashMovementRequestsReviewed CashMovementRequest[] @relation("CashMovementApprovedBy")
  endOfDaysClosed              EndOfDay[]
  returnsRequested             Return[]              @relation("ReturnRequestedBy")
  returnsApproved              Return[]              @relation("ReturnApprovedBy")
  salesVoided                  Sale[]                @relation("SaleVoidedBy")
  inventoryMovementsCreated    InventoryMovement[]
  posCheckouts                 PosCheckout[]
  refreshTokenSessions         RefreshTokenSession[]
  auditLogs                    AuditLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, email])
  @@index([tenantId])
  @@index([branchId])
}

model RefreshTokenSession {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  tokenId   String    @unique
  tokenHash String
  expiresAt DateTime
  revokedAt DateTime?

  replacedById String?
  replacedBy   RefreshTokenSession?  @relation("RefreshTokenRotation", fields: [replacedById], references: [id], onDelete: SetNull)
  replaces     RefreshTokenSession[] @relation("RefreshTokenRotation")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, revokedAt])
  @@index([expiresAt])
}

model AuditLog {
  id String @id @default(cuid())

  tenantId String?
  tenant   Tenant? @relation(fields: [tenantId], references: [id], onDelete: SetNull)

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  action String

  entityType String?
  entityId   String?

  requestId String?

  metadata Json?

  createdAt DateTime @default(now())

  @@index([tenantId])
  @@index([userId])
  @@index([action])
  @@index([entityType])
  @@index([entityId])
  @@index([createdAt])
}

model Customer {
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  id String @id @default(cuid())

  firstName String
  lastName  String?

  phone String?
  email String?

  dateOfBirth DateTime?

  isActive Boolean @default(true)

  loyaltyPoints Int @default(0)

  creditLimit Decimal @default(0) @db.Decimal(12, 2)

  notes String?

  sales         Sale[]
  cashMovements CashDrawerMovement[]
  orders        Order[]
  posCheckouts  PosCheckout[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, phone])
  @@unique([tenantId, email])
  @@index([tenantId])
  @@index([firstName])
  @@index([phone])
}

model Sale {
  id            String @id @default(cuid())
  saleNumber    String @unique
  receiptNumber String

  branchId String
  branch   Branch @relation(fields: [branchId], references: [id])

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  cashierId String?
  cashier   User?   @relation(fields: [cashierId], references: [id])

  voidedById String?
  voidedBy   User?   @relation("SaleVoidedBy", fields: [voidedById], references: [id])

  voidReason String?
  voidedAt   DateTime?

  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id])

  shiftId String?
  shift   Shift?  @relation(fields: [shiftId], references: [id])

  subtotal       Decimal @db.Decimal(12, 2)
  discountAmount Decimal @default(0) @db.Decimal(12, 2)
  taxAmount      Decimal @default(0) @db.Decimal(12, 2)
  totalAmount    Decimal @db.Decimal(12, 2)

  amountPaid   Decimal @db.Decimal(12, 2)
  changeAmount Decimal @default(0) @db.Decimal(12, 2)

  status SaleStatus @default(COMPLETED)

  items               SaleItem[]
  payments            Payment[]
  returns             Return[]
  paymentTransactions PaymentTransaction[]
  posCheckout         PosCheckout?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, receiptNumber])
  @@index([branchId, createdAt])
  @@index([cashierId])
  @@index([shiftId])
  @@index([voidedById])
  @@index([customerId])
}

model Shift {
  id String @id @default(cuid())

  shiftNumber String @unique

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  branchId String
  branch   Branch @relation(fields: [branchId], references: [id])

  userId String
  user   User   @relation(fields: [userId], references: [id])

  status ShiftStatus @default(OPEN)

  openingCash Decimal @default(0) @db.Decimal(12, 2)

  expectedCash Decimal? @db.Decimal(12, 2)

  countedCash Decimal? @db.Decimal(12, 2)

  cashDifference Decimal? @db.Decimal(12, 2)

  openedAt DateTime @default(now())

  closedAt DateTime?

  notes String?

  sales         Sale[]
  cashMovements CashDrawerMovement[]
  posCheckouts  PosCheckout[]

  cashMovementRequests CashMovementRequest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([branchId])
  @@index([userId])
  @@index([status])
  @@index([openedAt])
}

model CashDrawerMovement {
  id String @id @default(cuid())

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  branchId String
  branch   Branch @relation(fields: [branchId], references: [id])

  shiftId String
  shift   Shift  @relation(fields: [shiftId], references: [id])

  userId String
  user   User   @relation(fields: [userId], references: [id])

  type CashMovementType

  amount Decimal @db.Decimal(12, 2)

  reference String?
  notes     String?

  createdAt  DateTime  @default(now())
  customer   Customer? @relation(fields: [customerId], references: [id])
  customerId String?

  request CashMovementRequest?

  @@index([tenantId])
  @@index([branchId])
  @@index([shiftId])
  @@index([userId])
  @@index([type])
  @@index([createdAt])
}

model CashMovementRequest {
  id String @id @default(cuid())

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  branchId String
  branch   Branch @relation(fields: [branchId], references: [id])

  shiftId String
  shift   Shift  @relation(fields: [shiftId], references: [id])

  requestedById String
  requestedBy   User   @relation("CashMovementRequestedBy", fields: [requestedById], references: [id])

  approvedById String?
  approvedBy   User?   @relation("CashMovementApprovedBy", fields: [approvedById], references: [id])

  type CashAdjustmentType

  amount Decimal @db.Decimal(12, 2)

  reason String

  reference String?

  status CashMovementApprovalStatus @default(PENDING)

  requestedAt DateTime  @default(now())
  reviewedAt  DateTime?

  reviewNotes String?

  movementId String?             @unique
  movement   CashDrawerMovement? @relation(fields: [movementId], references: [id])

  @@index([tenantId])
  @@index([branchId])
  @@index([shiftId])
  @@index([requestedById])
  @@index([approvedById])
  @@index([status])
}

model EndOfDay {
  id String @id @default(cuid())

  businessDate DateTime

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  branchId String
  branch   Branch @relation(fields: [branchId], references: [id])

  closedById String?
  closedBy   User?   @relation(fields: [closedById], references: [id])

  status EndOfDayStatus @default(OPEN)

  totalSales Decimal @default(0) @db.Decimal(14, 2)

  totalDiscount Decimal @default(0) @db.Decimal(14, 2)

  totalReturns Decimal @default(0) @db.Decimal(14, 2)

  netSales Decimal @default(0) @db.Decimal(14, 2)

  cashTotal Decimal @default(0) @db.Decimal(14, 2)

  mpesaTotal Decimal @default(0) @db.Decimal(14, 2)

  cardTotal Decimal @default(0) @db.Decimal(14, 2)

  bankTotal Decimal @default(0) @db.Decimal(14, 2)

  insuranceTotal Decimal @default(0) @db.Decimal(14, 2)

  otherTotal Decimal @default(0) @db.Decimal(14, 2)

  transactionCount Int @default(0)

  shiftCount Int @default(0)

  totalCashVariance Decimal @default(0) @db.Decimal(14, 2)

  openedAt DateTime @default(now())

  closedAt DateTime?

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, branchId, businessDate])
  @@index([tenantId])
  @@index([branchId])
  @@index([businessDate])
  @@index([status])
}

model Return {
  id String @id @default(cuid())

  returnNumber String @unique

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  branchId String
  branch   Branch @relation(fields: [branchId], references: [id])

  saleId String
  sale   Sale   @relation(fields: [saleId], references: [id])

  requestedById String
  requestedBy   User   @relation("ReturnRequestedBy", fields: [requestedById], references: [id])

  approvedById String?
  approvedBy   User?   @relation("ReturnApprovedBy", fields: [approvedById], references: [id])

  status ReturnStatus @default(PENDING)

  refundMethod RefundMethod

  refundAmount Decimal @default(0) @db.Decimal(12, 2)

  reason String

  requestedAt DateTime  @default(now())
  approvedAt  DateTime?
  completedAt DateTime?

  items ReturnItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([branchId])
  @@index([saleId])
  @@index([status])
}

model ReturnItem {
  id String @id @default(cuid())

  returnId String
  return   Return @relation(fields: [returnId], references: [id])

  saleItemId String
  saleItem   SaleItem @relation(fields: [saleItemId], references: [id])

  productId String
  product   Product @relation(fields: [productId], references: [id])

  quantity Decimal @db.Decimal(12, 3)

  unitPrice Decimal @db.Decimal(12, 2)

  refundAmount Decimal @db.Decimal(12, 2)

  createdAt DateTime @default(now())

  @@index([returnId])
  @@index([saleItemId])
  @@index([productId])
}

model Order {
  id String @id @default(cuid())

  orderNumber String @unique

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  branchId String
  branch   Branch @relation(fields: [branchId], references: [id])

  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id])

  status OrderStatus @default(PENDING)

  paymentStatus OrderPaymentStatus @default(UNPAID)

  fulfilmentMethod FulfilmentMethod

  subtotal Decimal @db.Decimal(12, 2)

  discount Decimal @default(0) @db.Decimal(12, 2)

  deliveryFee Decimal @default(0) @db.Decimal(12, 2)

  total Decimal @db.Decimal(12, 2)

  recipientName String?

  recipientPhone String?

  deliveryAddress String?

  notes String?

  reservedAt DateTime?

  reservationExpiresAt DateTime?

  confirmedAt DateTime?

  fulfilledAt DateTime?

  cancelledAt DateTime?

  idempotencyKey String? @unique

  items               OrderItem[]
  reservations        InventoryReservation[]
  paymentTransactions PaymentTransaction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([branchId])
  @@index([customerId])
  @@index([status])
  @@index([paymentStatus])
  @@index([createdAt])
  @@index([idempotencyKey])
}

model PaymentTransaction {
  id String @id @default(cuid())

  transactionNumber String @unique

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  branchId String
  branch   Branch @relation(fields: [branchId], references: [id])

  targetType PaymentTargetType

  saleId String?
  sale   Sale?   @relation(fields: [saleId], references: [id])

  orderId String?
  order   Order?  @relation(fields: [orderId], references: [id])

  posCheckoutId String?
  posCheckout   PosCheckout? @relation(fields: [posCheckoutId], references: [id])

  provider PaymentProvider

  status PaymentTransactionStatus @default(INITIATED)

  amount Decimal @db.Decimal(12, 2)

  currency String @default("KES")

  phone String?

  externalReference String?

  providerRequestId String?

  providerCheckoutId String? @unique

  providerAmount Decimal? @db.Decimal(12, 2)

  providerPhone String?

  providerTransactionDate DateTime?

  failureCode   String?
  failureReason String?

  initiatedAt           DateTime  @default(now())
  callbackReceivedAt    DateTime?
  verificationStartedAt DateTime?
  completedAt           DateTime?
  failedAt              DateTime?

  rawResponse     Json?
  rawCallback     Json?
  rawVerification Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([provider, externalReference])
  @@index([tenantId])
  @@index([branchId])
  @@index([saleId])
  @@index([orderId])
  @@index([posCheckoutId])
  @@index([provider])
  @@index([status])
  @@index([externalReference])
}

model PaymentCallbackEvent {
  id String @id @default(cuid())

  provider PaymentProvider

  providerCheckoutId String?

  payload Json

  processed Boolean @default(false)

  processingResult String?

  receivedAt DateTime @default(now())

  processedAt DateTime?

  @@index([provider])
  @@index([providerCheckoutId])
  @@index([receivedAt])
}

model InventoryMovement {
  id String @id @default(cuid())

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  branchId String
  branch   Branch @relation(fields: [branchId], references: [id])

  productId String
  product   Product @relation(fields: [productId], references: [id])

  type           InventoryMovementType
  quantity       Decimal               @db.Decimal(12, 3)
  quantityBefore Decimal               @db.Decimal(12, 3)
  quantityAfter  Decimal               @db.Decimal(12, 3)

  referenceType   String?
  referenceId     String?
  referenceNumber String?
  notes           String?

  createdById String?
  createdBy   User?   @relation(fields: [createdById], references: [id])

  createdAt DateTime @default(now())

  @@index([tenantId])
  @@index([branchId])
  @@index([productId])
  @@index([type])
  @@index([referenceId])
  @@index([createdAt])
}

model PosCheckout {
  id String @id @default(cuid())

  checkoutNumber String @unique

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  branchId String
  branch   Branch @relation(fields: [branchId], references: [id])

  cashierId String
  cashier   User   @relation(fields: [cashierId], references: [id])

  shiftId String
  shift   Shift  @relation(fields: [shiftId], references: [id])

  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id])

  status PosCheckoutStatus @default(AWAITING_PAYMENT)

  subtotal       Decimal @db.Decimal(12, 2)
  discountAmount Decimal @default(0) @db.Decimal(12, 2)
  taxAmount      Decimal @default(0) @db.Decimal(12, 2)
  totalAmount    Decimal @db.Decimal(12, 2)

  reservedAt           DateTime?
  reservationExpiresAt DateTime?

  paymentStartedAt DateTime?
  completedAt      DateTime?
  cancelledAt      DateTime?
  failedAt         DateTime?
  expiredAt        DateTime?

  saleId String? @unique
  sale   Sale?   @relation(fields: [saleId], references: [id])

  items               PosCheckoutItem[]
  reservations        InventoryReservation[]
  paymentTransactions PaymentTransaction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([branchId])
  @@index([cashierId])
  @@index([shiftId])
  @@index([customerId])
  @@index([status])
  @@index([createdAt])
}

model PosCheckoutItem {
  id String @id @default(cuid())

  posCheckoutId String
  posCheckout   PosCheckout @relation(fields: [posCheckoutId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id])

  quantity       Decimal @db.Decimal(12, 3)
  unitPrice      Decimal @db.Decimal(12, 2)
  discountAmount Decimal @default(0) @db.Decimal(12, 2)
  lineTotal      Decimal @db.Decimal(12, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([posCheckoutId])
  @@index([productId])
}

model InventoryReservation {
  id String @id @default(cuid())

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  branchId String
  branch   Branch @relation(fields: [branchId], references: [id])

  productId String
  product   Product @relation(fields: [productId], references: [id])

  orderId String?
  order   Order?  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  posCheckoutId String?
  posCheckout   PosCheckout? @relation(fields: [posCheckoutId], references: [id], onDelete: Cascade)

  quantity   Decimal           @db.Decimal(12, 3)
  status     ReservationStatus @default(ACTIVE)
  expiresAt  DateTime
  createdAt  DateTime          @default(now())
  consumedAt DateTime?
  releasedAt DateTime?
  expiredAt  DateTime?
  updatedAt  DateTime          @updatedAt

  @@unique([orderId, productId])
  @@unique([posCheckoutId, productId])
  @@index([tenantId])
  @@index([branchId])
  @@index([productId])
  @@index([orderId])
  @@index([status])
  @@index([expiresAt])
}

model OrderItem {
  id String @id @default(cuid())

  orderId String
  order   Order  @relation(fields: [orderId], references: [id])

  productId String
  product   Product @relation(fields: [productId], references: [id])

  quantity Decimal @db.Decimal(12, 3)

  unitPrice Decimal @db.Decimal(12, 2)

  lineTotal Decimal @db.Decimal(12, 2)

  createdAt DateTime @default(now())

  @@index([orderId])
  @@index([productId])
}

model SaleItem {
  id String @id @default(cuid())

  saleId String
  sale   Sale   @relation(fields: [saleId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id])

  quantity  Decimal @db.Decimal(12, 3)
  unitPrice Decimal @db.Decimal(12, 2)

  discountAmount Decimal @default(0) @db.Decimal(12, 2)
  taxAmount      Decimal @default(0) @db.Decimal(12, 2)
  lineTotal      Decimal @db.Decimal(12, 2)

  createdAt DateTime @default(now())

  returnItems ReturnItem[]

  @@index([saleId])
  @@index([productId])
}

model Payment {
  id String @id @default(cuid())

  saleId String
  sale   Sale   @relation(fields: [saleId], references: [id], onDelete: Cascade)

  method PaymentMethod
  amount Decimal       @db.Decimal(12, 2)

  reference String?

  createdAt DateTime @default(now())

  @@index([saleId])
}

enum UserRole {
  SUPER_ADMIN
  TENANT_ADMIN
  MANAGER
  PHARMACIST
  CASHIER
  INVENTORY_MANAGER
  PROCUREMENT_OFFICER
  ACCOUNTANT
  ECOMMERCE_MANAGER
  REPORT_VIEWER
}

enum SaleStatus {
  PENDING
  COMPLETED
  VOIDED
  REFUNDED
}

enum ShiftStatus {
  OPEN
  CLOSED
}

enum PaymentMethod {
  CASH
  MPESA
  CARD
  BANK
  BANK_TRANSFER
  INSURANCE
  OTHER
}

enum PriceChannel {
  POS
  ECOMMERCE
}

enum PaymentProvider {
  CASH
  MPESA
  CARD
  BANK
  INSURANCE
  OTHER
}

enum PaymentTransactionStatus {
  INITIATED
  PENDING
  VERIFYING
  SUCCEEDED
  FAILED
  CANCELLED
  REFUNDED
  REQUIRES_REVIEW
}

enum PaymentTargetType {
  SALE
  ORDER
  POS_CHECKOUT
}

enum PosCheckoutStatus {
  AWAITING_PAYMENT
  PAYMENT_PENDING
  COMPLETED
  FAILED
  CANCELLED
  EXPIRED
}

enum CashMovementType {
  OPENING_FLOAT
  CASH_SALE
  CASH_REFUND
  CASH_IN
  CASH_OUT
  BANK_DROP
  CLOSING_COUNT
}

enum CashMovementApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum CashAdjustmentType {
  CASH_IN
  CASH_OUT
  BANK_DROP
}

enum OrderStatus {
  PENDING
  AWAITING_PAYMENT
  CONFIRMED
  PROCESSING
  READY_FOR_DISPATCH
  DISPATCHED
  DELIVERED
  CANCELLED
  FAILED
}

enum OrderPaymentStatus {
  UNPAID
  PENDING
  PAID
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum FulfilmentMethod {
  DELIVERY
  PICKUP
}

enum ReturnStatus {
